# LLM API Keys
OPENAI_API_KEY=sk-...
#ANTHROPIC_API_KEY=sk-ant-...

# Langfuse (docker-compose 기동 후 http://localhost:3002 에서 프로젝트 생성 후 입력)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# Docker 내부에서 실행 시: http://langfuse:3000 / 로컬 직접 실행 시: http://localhost:3002
LANGFUSE_HOST=http://localhost:3002

# Grafana (기본값 그대로 사용 가능)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123

# Ollama (오프라인 데모용, 로컬 설치 필요)
OLLAMA_BASE_URL=http://localhost:11434

# ngrok (외부 서비스 연동용 터널 - https://dashboard.ngrok.com/authtokens 에서 발급)
NGROK_AUTHTOKEN=your-ngrok-token
# Docker 내부 실행 시: http://ngrok:4040 / 로컬 직접 실행 시: http://localhost:4040
NGROK_API_URL=http://localhost:4040