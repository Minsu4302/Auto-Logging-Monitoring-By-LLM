# LLM API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Langfuse (docker-compose 기동 후 http://localhost:3002 에서 프로젝트 생성 후 입력)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Grafana (기본값 그대로 사용 가능)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123

# Ollama (오프라인 데모용, 로컬 설치 필요)
OLLAMA_BASE_URL=http://localhost:11434
